{
  "manifest_version": 3,
  "name": "MyWay 預約搶位",
  "version": "1.2.0",
  "description": "mywaygoods.com 自動選日期/最早場次、加入購物車、結帳並填入帳單資料",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://mywaygoods.com/*",
    "https://*.myshopify.com/*",
    "https://account.mywaygoods.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MyWay 預約搶位",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://mywaygoods.com/*",
        "https://*.myshopify.com/*",
        "https://account.mywaygoods.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}