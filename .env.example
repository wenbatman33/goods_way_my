# ===== 複製成 .env 後填寫（.env 放在插件資料夾根目錄）=====
# 修改 .env 後，到插件 popup 按「重新載入 .env」即可生效

# ---------- 預約目標 ----------
# 商品網址；留空 = 自動從首頁找「含有目標日期」的預約商品
PRODUCT_URL=
# 商品名稱關鍵字（正規式，| 表示或）；自動找商品時只接受符合者，避免選到舊場地
PRODUCT_KEYWORD=Garden City|遠東
# 目標日期（月/日），10/2 或 10/02 皆可
TARGET_DATE=10/02
# 入場區間限制（可留空）：只接受開始時間介於這兩者之間的場次，越早越優先
EARLIEST_START=
LATEST_START=
# 購物車數量
QUANTITY=1

# ---------- 行為 ----------
# 沒有可預約場次時的重試間隔（毫秒），勿設太低以免被擋
POLL_INTERVAL_MS=1000
# 開賣時間（YYYY-MM-DD HH:MM:SS；只寫 HH:MM:SS = 今天；留空 = 按下開始立即執行）
START_AT=2026-09-29 18:00:00
# 提前幾秒開始輪詢
PRE_START_SECONDS=10
# 點擊模式：開賣後每輪重整首頁、按鈕一開放就點擊（與背景偵測同時進行）
CLICK_MODE=true
# 找到場次、加入購物車後，先切到商品頁顯示再進結帳（true / false）
SHOW_PRODUCT_PAGE=true
# 商品頁停留毫秒數
SHOW_PRODUCT_MS=1000
# 結帳頁填完資料後是否自動按「完成訂單」（true / false）
AUTO_COMPLETE_ORDER=true

# ---------- 聯絡資料（結帳頁若要求 Email）----------
EMAIL=

# ---------- 帳單地址 ----------
COUNTRY_CODE=TW
FIRST_NAME=
LAST_NAME=
ADDRESS1=
ADDRESS2=
CITY=
POSTAL_CODE=
PHONE=
